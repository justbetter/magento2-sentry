<?php
/** @var \JustBetter\Sentry\Block\SentryScript $block */
$javascriptContext = $block->getJavascriptContextJson();
$stripStaticContentVersion = $block->stripStaticContentVersion();
$stripStoreCode = $block->stripStoreCode();
$rewriteFrames = $stripStaticContentVersion || $stripStoreCode;
?>
if (typeof Sentry !== 'undefined') {
    <?php if ($javascriptContext !== null): ?>
        var sentryMagentoContext = <?= /** @noEscape */ $javascriptContext ?>;
    <?php endif ?>
    Sentry.init({
    dsn: '<?= $escaper->escapeUrl(trim($block->getDSN())) ?>',
    release: '<?= $escaper->escapeHtml(trim((string) $block->getVersion())) ?>',
    environment: '<?= $escaper->escapeHtml(trim($block->getEnvironment())) ?>',
    <?php if ($javascriptContext !== null): ?>
        initialScope: {
        tags: sentryMagentoContext.tags,
        },
    <?php endif ?>
    integrations: [
    <?php if ($block->isTracingEnabled()): ?>
        Sentry.browserTracingIntegration({
        enableInp: true,
        <?php if ($javascriptContext !== null): ?>
            beforeStartSpan: function (options) {
            if (options.op !== 'pageload') {
            return options;
            }

            return Object.assign({}, options, { name: sentryMagentoContext.transaction });
            },
        <?php endif ?>
        }),
    <?php endif ?>
    <?php if ($block->useSessionReplay()): ?>
        Sentry.replayIntegration({
        blockAllMedia: <?= $escaper->escapeHtml($block->getReplayBlockMedia() ? 'true' : 'false') ?>,
        maskAllText: <?= $escaper->escapeHtml($block->getReplayMaskText() ? 'true' : 'false') ?>,
        })
    <?php endif ?>
    ],
    <?php if ($block->isTracingEnabled()): ?>
        tracesSampleRate: <?= $escaper->escapeHtml($block->getTracingSampleRate()) ?>,
    <?php endif ?>
    <?php if ($block->useSessionReplay()): ?>
        replaysSessionSampleRate: <?= $escaper->escapeHtml($block->getReplaySessionSampleRate()) ?>,
        replaysOnErrorSampleRate: <?= $escaper->escapeHtml($block->getReplayErrorSampleRate()) ?>,
    <?php endif ?>
    ignoreErrors: <?= /** @noEscape */ $block->getIgnoreJsErrors() ?>,
    <?php if ($javascriptContext !== null || $rewriteFrames): ?>
        beforeSend: function (event) {
        <?php if ($javascriptContext !== null): ?>
            event.transaction = sentryMagentoContext.transaction;
        <?php endif ?>
        <?php if ($rewriteFrames): ?>
            var values = (event.exception && event.exception.values) || [];

            values.forEach(function (value) {
            if (!value.stacktrace || !value.stacktrace.frames) {
            return;
            }

            value.stacktrace.frames.forEach(function (frame) {
            if (typeof frame.filename !== 'string') {
            return;
            }

            <?php if ($stripStaticContentVersion): ?>
                frame.filename = frame.filename.replace(/version[0-9]{10}\//, '');
            <?php endif ?>
            <?php if ($stripStoreCode): ?>
                <?php // phpcs:disable Generic.Files.LineLength ?>
                frame.filename = frame.filename.replace('/<?= $escaper->escapeHtml($block->getStoreCode()); ?>/', '/');
                <?php // phpcs:enable Generic.Files.LineLength ?>
            <?php endif ?>
            });
            });
        <?php endif ?>

        return event;
        }
    <?php endif ?>
    });
}
