<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Startup & Exception catching -->
    <type name="Magento\Framework\AppInterface">
        <plugin disabled="false" name="GlobalExceptionCatcher" type="JustBetter\Sentry\Plugin\GlobalExceptionCatcher"
                sortOrder="0"/>
    </type>

    <type name="Symfony\Component\Console\Command\Command">
        <plugin disabled="false" name="CliExceptionCatcher" type="JustBetter\Sentry\Plugin\GlobalExceptionCatcher"
                sortOrder="0"/>
    </type>

    <!-- Log catching-->
    <type name="Monolog\Logger">
        <plugin disabled="false" name="SentryMonologPlugin" type="JustBetter\Sentry\Plugin\MonologPlugin" sortOrder="10"/>
    </type>

    <type name="JustBetter\Sentry\Plugin\MonologPlugin">
        <arguments>
            <argument name="sentryHandler" xsi:type="object">JustBetter\Sentry\Logger\Handler\Sentry\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Customer\CustomerData\Customer">
        <plugin name="LogrocketCustomerInfo" type="JustBetter\Sentry\Plugin\LogrocketCustomerInfo"
                sortOrder="10" disabled="false"/>
    </type>

    <type name="JustBetter\Sentry\Model\SentryLog">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <type name="JustBetter\Sentry\Logger\Handler\Sentry">
        <arguments>
            <argument name="sentryHelper" xsi:type="object">JustBetter\Sentry\Helper\Data\Proxy</argument>
            <argument name="sentryLog" xsi:type="object">JustBetter\Sentry\Model\SentryLog\Proxy</argument>
        </arguments>
    </type>

    <!-- Content Security Policies -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="sentry" xsi:type="object" sortOrder="99">JustBetter\Sentry\Model\Collector\SentryRelatedCspCollector\Proxy</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Csp\Api\ModeConfigManagerInterface">
        <plugin name="sentry-set-report-uri" type="JustBetter\Sentry\Plugin\CspModeConfigManagerPlugin"/>
    </type>

    <!-- Tracing / Profiling -->
    <type name="Magento\Framework\Event\ManagerInterface">
        <plugin name="sentry-profiling-events" type="JustBetter\Sentry\Plugin\Profiling\EventManagerPlugin" disabled="false" />
    </type>
    <type name="Magento\Framework\View\Element\Template">
        <plugin name="sentry-profiling-templates" type="JustBetter\Sentry\Plugin\Profiling\TemplatePlugin" disabled="false" />
    </type>
    <type name="Magento\Framework\DB\Logger\LoggerProxy">
        <plugin name="sentry-profiling-db-queries" type="JustBetter\Sentry\Plugin\Profiling\DbQueryLoggerPlugin" disabled="false" />
    </type>
    <type name="Magento\Framework\MessageQueue\ExchangeInterface">
        <plugin name="sentry-profiling-enqueue" type="JustBetter\Sentry\Plugin\Profiling\ExchangePlugin" disabled="false" />
    </type>
    <type name="Magento\Framework\MessageQueue\Bulk\ExchangeInterface">
        <plugin name="sentry-profiling-enqueue-bulk" type="JustBetter\Sentry\Plugin\Profiling\ExchangePlugin" disabled="false" />
    </type>
    <type name="Magento\Framework\MessageQueue\MessageEncoder">
        <plugin name="sentry-profiling-queue-message-encoder" type="JustBetter\Sentry\Plugin\Profiling\QueueMessageEncoderPlugin" disabled="false" />
    </type>
    <type name="Magento\Framework\MessageQueue\QueueInterface">
        <plugin name="sentry-profiling-queue-runner" type="JustBetter\Sentry\Plugin\Profiling\QueuePlugin" disabled="false" />
    </type>
    <type name="Magento\Framework\App\Cache\Frontend\Factory">
        <arguments>
            <argument name="decorators" xsi:type="array">
                <item name="sentry" xsi:type="array">
                    <item name="class" xsi:type="string">JustBetter\Sentry\Plugin\Profiling\Cache</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Cron Check-Ins -->
    <type name="Magento\Cron\Model\Schedule">
        <plugin name="sentry-cron-checkin" type="JustBetter\Sentry\Plugin\CronScheduleCheckIn" disabled="false"/>
    </type>

    <!-- Resilient async delivery -->
    <type name="JustBetter\Sentry\Model\SentryInteraction">
        <arguments>
            <argument name="resilientTransportFactory" xsi:type="object">JustBetter\Sentry\Model\Transport\ResilientTransportFactory\Proxy</argument>
        </arguments>
    </type>

    <type name="JustBetter\Sentry\Model\Transport\ResilientTransportFactory">
        <arguments>
            <argument name="publisher" xsi:type="object">JustBetter\Sentry\Model\Queue\Publisher\SentryEventPublisher\Proxy</argument>
            <argument name="circuitBreaker" xsi:type="object">JustBetter\Sentry\Model\CircuitBreaker\Proxy</argument>
            <argument name="helper" xsi:type="object">JustBetter\Sentry\Helper\Data\Proxy</argument>
        </arguments>
    </type>

    <type name="JustBetter\Sentry\Model\Queue\Consumer\SentryEventConsumer">
        <arguments>
            <argument name="envelopeSender" xsi:type="object">JustBetter\Sentry\Model\Transport\EnvelopeSender\Proxy</argument>
            <argument name="circuitBreaker" xsi:type="object">JustBetter\Sentry\Model\CircuitBreaker\Proxy</argument>
            <argument name="helper" xsi:type="object">JustBetter\Sentry\Helper\Data\Proxy</argument>
            <argument name="logger" xsi:type="object">JustBetter\Sentry\Logger\DeliveryLogger</argument>
        </arguments>
    </type>

    <virtualType name="JustBetter\Sentry\Model\Transport\EnvelopeHttpClient" type="Sentry\HttpClient\HttpClient">
        <arguments>
            <argument name="sdkIdentifier" xsi:type="const">JustBetter\Sentry\Model\SentryInteraction::SDK_IDENTIFIER</argument>
            <argument name="sdkVersion" xsi:type="const">Sentry\Client::SDK_VERSION</argument>
        </arguments>
    </virtualType>

    <!-- Async consumer client only; the request-path client is built in ResilientTransportFactory::create() -->
    <virtualType name="JustBetter\Sentry\Model\Transport\EnvelopeRecordingHttpClient" type="JustBetter\Sentry\Model\Transport\ResponseRecordingHttpClient">
        <arguments>
            <argument name="httpClient" xsi:type="object">JustBetter\Sentry\Model\Transport\EnvelopeHttpClient</argument>
        </arguments>
    </virtualType>

    <type name="JustBetter\Sentry\Model\Transport\EnvelopeSender">
        <arguments>
            <argument name="httpClient" xsi:type="object">JustBetter\Sentry\Model\Transport\EnvelopeRecordingHttpClient</argument>
        </arguments>
    </type>

    <!-- Delivery failures: file only, excluded from Sentry by MonologPlugin::EXCLUDED_CHANNEL -->
    <virtualType name="JustBetter\Sentry\Logger\Handler\DeliveryFile" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/sentry.log</argument>
        </arguments>
    </virtualType>

    <!-- Plain Monolog\Logger: Magento\Framework\Logger\Monolog would inherit global handlers from app/etc/di.xml -->
    <virtualType name="JustBetter\Sentry\Logger\DeliveryLogger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="const">JustBetter\Sentry\Plugin\MonologPlugin::EXCLUDED_CHANNEL</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">JustBetter\Sentry\Logger\Handler\DeliveryFile</item>
            </argument>
        </arguments>
    </virtualType>
</config>
