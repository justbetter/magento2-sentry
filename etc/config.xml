<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <sentry>
            <general>
                <enable_php_tracking>1</enable_php_tracking>
                <performance_tracking_enabled>0</performance_tracking_enabled>
                <enable_script_tag>0</enable_script_tag>
                <script_tag_placement>before.body.end</script_tag_placement>
            </general>
            <issue_grouping>
                <strip_static_content_version/>
                <strip_store_code/>
                <add_action_context/>
            </issue_grouping>
            <environment>
                <dsn/>
                <environment/>
                <log_level/>
                <graphql_report_client_safe_errors/>
                <error_types/>
                <ignore_exceptions/>
                <mage_mode_development/>
                <js_sdk_version/>
                <tracing_enabled/>
                <tracing_sample_data/>
                <ignore_js_errors/>
                <async_sending_enabled/>
                <circuit_breaker_failure_threshold/>
                <circuit_breaker_recovery_timeout/>
                <circuit_breaker_success_threshold/>
                <http_timeout/>
                <http_connect_timeout/>
            </environment>
        </sentry>
    </default>
</config>
